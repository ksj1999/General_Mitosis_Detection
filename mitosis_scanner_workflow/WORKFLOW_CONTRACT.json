{
  "name": "midogpp-scanner-robustness",
  "version": "1.0.0",
  "entrypoint": "mitosis_scanner_workflow/run_workflow.py",
  "task": "tile_object_detection",
  "model": "fasterrcnn_resnet50_fpn",
  "commands": [
    "validate",
    "prepare",
    "train",
    "evaluate",
    "run",
    "matrix",
    "summarize"
  ],
  "holdouts": [
    "Aperio_CS2",
    "Hamamatsu_S360",
    "Hamammatsu_XR"
  ],
  "variants": [
    "baseline",
    "mild_color_jitter",
    "strong_color_jitter",
    "reinhard_rgb"
  ],
  "inputs": {
    "train_annotations": "demo1/detection_tiles/<holdout>/train_tiles_coco.json",
    "test_annotations": "demo1/detection_tiles/<holdout>/test_tiles_coco.json",
    "image_paths": "relative to each COCO annotation file"
  },
  "outputs": {
    "root": "mitosis_scanner_workflow/artifacts/<holdout>/<variant>",
    "checkpoint": "final.pt",
    "protocol_summary": "locked_protocol/protocol_summary.json",
    "metrics_json": "locked_protocol/test/metrics.json",
    "metrics_csv": "locked_protocol/test/metrics.csv"
  },
  "invariants": [
    "random augmentation is train-only",
    "normalization mode is identical at train and evaluation",
    "checkpoint and score threshold are selected on validation data only",
    "held-out scanner is not used to fit preprocessing",
    "generated data and weights are not committed"
  ]
}
