{
  "data": {
    "subset_root": "breast_cancer_subset",
    "detection_coco_root": "demo1/detection_coco",
    "detection_tiles_root": "demo1/detection_tiles",
    "tile_size": 512,
    "negative_ratio": 1.0
  },
  "outputs": {
    "artifact_root": "mitosis_scanner_workflow/artifacts"
  },
  "training": {
    "device": "cuda",
    "epochs": 8,
    "batch_size": 1,
    "learning_rate": 0.0001,
    "weight_decay": 0.0001,
    "clip_grad_norm": 1.0,
    "num_workers": 0,
    "save_every": 0,
    "seed": 42
  },
  "evaluation": {
    "batch_size": 4,
    "iou_threshold": 0.3,
    "score_thresholds": "0.05,0.1,0.2,0.3,0.5,0.7"
  },
  "holdouts": {
    "Aperio_CS2": "Aperio_CS2",
    "Hamamatsu_S360": "Hamamatsu_S360",
    "Hamammatsu_XR": "Hamammatsu_XR"
  },
  "variants": {
    "baseline": {
      "augmentation": "none",
      "normalization": "none"
    },
    "mild_color_jitter": {
      "augmentation": "mild",
      "normalization": "none"
    },
    "strong_color_jitter": {
      "augmentation": "strong",
      "normalization": "none"
    },
    "reinhard_rgb": {
      "augmentation": "none",
      "normalization": "reinhard_rgb"
    }
  }
}
